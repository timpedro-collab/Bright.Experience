# Bright.Experience — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Required ─────────────────────────────────────────────────────────

# Supabase — Project connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL — canonical public URL used for email links, Supabase auth
# redirects (password reset, magic links), and Open Graph metadata.
# Set to your Vercel/production domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Recommended ──────────────────────────────────────────────────────

# Supabase service-role key — required for cron jobs, invites, and any
# query that needs to bypass RLS. Treat it like a database password:
# never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — Transactional email for notifications, digests, and invites.
# When unset, emails are logged to the console instead.
#
# Setup:
#   1. Sign up at https://resend.com and verify a sending domain
#   2. Create an API key and paste it below
#   3. (Optional) Override the from/team addresses
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# FROM_EMAIL=noreply@brightblue.co.uk
# STUDIO_TEAM_EMAIL=studio@brightblue.co.uk
# SALES_TEAM_EMAIL=sales@brightblue.co.uk

# ── Optional ─────────────────────────────────────────────────────────

# Mock mode — when "true", use the in-memory mock Supabase dataset
# (src/lib/supabase/mock/) instead of a live project. Ideal for UI demos
# and offline work. Leave unset / "false" for real auth, RLS, and storage.
# NEXT_PUBLIC_MOCK_MODE=true

# Booking auto-provision — when "true", an accepted proposal or a book-now
# submission immediately spins up a real account, event workspace and customer
# invite. Leave UNSET for demos/sandboxes so funnel walkthroughs land as
# in-flight quotes an internal user converts deliberately (no throwaway events,
# no real invite emails). Set to "true" only in production.
# BOOKING_AUTO_PROVISION=true

# Cron — shared secret protecting /api/cron/* routes. Vercel Cron sends
# an `Authorization: Bearer ${CRON_SECRET}` header on every invocation when
# this is set; any request without a matching bearer gets a 401. (The old
# `x-vercel-cron` header bypass was removed — it was spoofable.)
# Generate a long random string and add it to your Vercel project settings.
# CRON_SECRET=replace-me-with-a-long-random-string

# Bright.Blue Cloud — live telemetry & webhooks (degrades gracefully)
# Outbound API: pulls live snapshots and post-show reports from Cloud
# BRIGHTBLUE_API_URL=https://cloud.bright.blue/api/v1
# BRIGHTBLUE_API_KEY=your-api-key-here
# Inbound webhooks: Cloud pushes telemetry, leads, heartbeats, and reports
# BRIGHTBLUE_WEBHOOK_SECRET=shared-hmac-secret-here

# Sentry — error observability. When the DSN is unset, capture calls are
# no-ops. The runtime SDK (client/server/edge) reads NEXT_PUBLIC_SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
#
# Build-time source-map upload (next.config.ts -> withSentryConfig) needs the
# org/project slugs plus an auth token. Without them the build still succeeds
# but stack traces stay minified. Set these in CI / Vercel project settings.
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=your-sentry-project-slug
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxx

# File scanning — malware screen for uploaded creative assets. When unset,
# uploads are accepted without scanning (local/dev/pre-handoff). Point this at
# a ClamAV REST shim or cloud AV endpoint that accepts raw bytes and returns
# JSON { clean: boolean, signature?: string }.
# FILE_SCAN_URL=https://scanner.internal/scan
# FILE_SCAN_TOKEN=optional-bearer-token

# Pipedrive — CRM write-back integration (no-op if unset).
# The token also lives in pipedrive_config.api_token once
# /admin/integrations/pipedrive is set up; this env override exists
# for local development.
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_BASE_URL=https://api.pipedrive.com
# Web app base URL for the "Open in Pipedrive" deal chip.
# NEXT_PUBLIC_PIPEDRIVE_WEB_BASE_URL=https://app.pipedrive.com
