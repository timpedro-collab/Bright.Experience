# Bright.Experience — Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase — Project connection (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key — required for the cron reminders + digest jobs so they
# can read across all rows regardless of RLS. Treat it like a database
# password: never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App — Public base URL for links in emails/proposals
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Resend — Email service for notifications (optional, logs to console if unset)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# STUDIO_TEAM_EMAIL=studio@brightblue.co.uk
# SALES_TEAM_EMAIL=sales@brightblue.co.uk
# FROM_EMAIL=noreply@brightblue.co.uk

# Cron — shared secret protecting /api/cron/* routes. Vercel Cron sends an
# `Authorization: Bearer ${CRON_SECRET}` header on every invocation; any
# request without it (or the `x-vercel-cron` header) gets a 401. Generate a
# long random string and add it to your Vercel project settings.
# CRON_SECRET=replace-me-with-a-long-random-string

# Pipedrive — write-back integration (optional, no-op if unset).
# The token also lives in pipedrive_config.api_token once /admin/integrations/
# pipedrive is set up; this env override exists for local development.
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_BASE_URL=https://api.pipedrive.com
# Web app base URL used for the "Open in Pipedrive" deal chip on the
# event context bar. Defaults to https://app.pipedrive.com — override
# with your org subdomain (e.g. https://acme.pipedrive.com) so the deal
# chip deep-links to your tenant.
# NEXT_PUBLIC_PIPEDRIVE_WEB_BASE_URL=https://app.pipedrive.com
