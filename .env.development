# ============================================================
# Development-only defaults — standalone mock demo
# ============================================================
# Next.js loads this file ONLY when NODE_ENV=development (`next dev`). It is
# never read by `next build` / `next start`, which is deliberate: mock mode
# fakes authentication (no password check, no RLS, no session validation), so it
# must be structurally impossible for it to reach a production build. See
# src/lib/supabase/mock/flag.ts for the second guard.
#
# `npm run dev` therefore gives you the whole frontend with no backend. Log in
# on /login with any seeded email (any password), e.g.:
#   theo@brightblue.co.uk   (creative team)
#   james.chen@cocacola.com (customer)
#   tim@brightblue.co.uk    (events lead)
#
# To run against real Postgres with RLS enforced instead:
#   npm run db:local && npm run dev:local
NEXT_PUBLIC_MOCK_MODE=1

# Placeholders only — never contacted while MOCK_MODE is on. Present so any
# code that reads them at startup doesn't choke on a missing value.
NEXT_PUBLIC_SUPABASE_URL=https://mock.local
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auto-provision a full event workspace when a quote is accepted / booked.
# Safe here because mock events are in-memory and the invite email is a no-op,
# so the end-to-end "accept proposal → live delivery workspace" demo works.
BOOKING_AUTO_PROVISION=true
