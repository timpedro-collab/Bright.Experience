# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything is ignored by default so no real credential can be
# committed. Only these two no-secret files are allowlisted:
.env*
# The example file MUST be committed so new engineers know which env vars to
# fill in. It contains no secrets.
!.env.example
# Development-only demo defaults (mock mode). Next.js reads this file only when
# NODE_ENV=development, so committing it cannot affect a production build.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI scratch / cache
supabase/.temp/

# reference codebase used for the redesign — not part of this app
/TheoCloudRedesign-main/

# playwright artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
