# ============================================================
# frontend-mock-data branch — standalone demo defaults
# ============================================================
# This branch runs the ENTIRE frontend on an in-memory mock dataset with no
# real backend. Clone, `npm install`, `npm run dev`, and everything renders.
# Log in on /login with any seeded email (any password), e.g.:
#   emma@brightblue.co.uk   (creative team)
#   james.chen@cocacola.com (customer)
#   sarah@brightblue.co.uk  (events lead)
#
# To run against the real Supabase backend instead, switch to `main`.
NEXT_PUBLIC_MOCK_MODE=1

# Placeholders only — never contacted while MOCK_MODE is on. Present so any
# code that reads them at startup doesn't choke on a missing value.
NEXT_PUBLIC_SUPABASE_URL=https://mock.local
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
